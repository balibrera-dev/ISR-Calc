{
  // Cloudflare Worker "isr-calc": sirve la SPA como archivos estáticos (sin backend).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "isr-calc",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
